<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <h1
    class="col-12 col-sm-10 offset-sm-1 col-md-8 offset-md-2 col-lg-6 offset-lg-3"
  >
    Login on Tripster
  </h1>

  <div
    class="col-12 col-sm-10 col-md-8 col-lg-6 offset-sm-1 offset-md-2 offset-lg-3"
  >
    <form method="POST" action="/login" novalidate class="needs-validation">
      <div class="mt-3">
        <label for="username" class="form-label">Username</label>
        <input
          name="username"
          id="username"
          type="text"
          class="form-control"
          required
        />
      </div>

      <div class="mt-3">
        <label for="password" class="form-label">Password</label>
        <input
          name="password"
          id="password"
          type="password"
          class="form-control"
          required
        />
      </div>
      <button class="btn btn-success mt-3 mb-5">Log In</button>
    </form>
  </div>
</div>
